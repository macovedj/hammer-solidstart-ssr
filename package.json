{
  "name": "hammer-solidstart-ssr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NAPI_RS_ENFORCE_VERSION_CHECK=1 vite dev --configLoader runner --host 0.0.0.0",
    "build": "cross-env NAPI_RS_ENFORCE_VERSION_CHECK=1 vite build --configLoader runner",
    "start": "node .output/server/index.mjs",
    "preview": "cross-env NAPI_RS_ENFORCE_VERSION_CHECK=1 vite preview --configLoader runner --host 0.0.0.0",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "npm run typecheck && npm run build",
    "test:smoke": "npm run check && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.5",
    "nitro": "3.0.260903-beta",
    "solid-js": "1.9.15",
    "vite": "8.3.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-wasm32-wasi": "1.2.11"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "rolldown": "1.2.11",
    "typescript": "7.0.2"
  }
}
