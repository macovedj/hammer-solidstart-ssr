{
  "name": "hammer-solidstart-ssr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test:smoke": "npm run check && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.5",
    "nitro": "3.0.260903-beta",
    "solid-js": "1.9.15",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
